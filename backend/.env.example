# Neon > Connect > Parameters only. Copy these values into backend/.env.
PGHOST=your-neon-host.neon.tech
PGDATABASE=neondb
PGUSER=your-neon-user
PGPASSWORD=replace-with-your-neon-password
PGPORT=5432
PGSSLMODE=require

# Generate a unique secret for production: openssl rand -hex 32
JWT_SECRET_KEY=local-development-only-change-this-secret-before-deploying
JWT_ACCESS_TOKEN_MINUTES=480

# Comma-separated origins. Add your deployed Vercel URL in Render.
CORS_ORIGINS=http://localhost:4200
APP_TIMEZONE=America/Lima

